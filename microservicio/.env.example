# ─── Microservicio: De PDF a Radicado ───

# ── App ──
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO

# ── Auth ──
INTERNAL_TOKEN=cambiar-por-token-seguro-en-produccion

# ── Redis / Celery ──
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── OCR / IA (extracción de documentos) ──
OCR_ENGINE=ai
GITHUB_TOKEN=ghp-tu-github-token-aqui
AI_MODEL=gpt-chat-latest
AI_BASE_URL=https://models.inference.ai.azure.com
# Alternativas: OCR_ENGINE=tesseract (sin IA) o OCR_ENGINE=textract (AWS)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# ── Validaciones externas ──
ADRES_BASE_URL=https://appweb.adres.gov.co
RETHUS_BASE_URL=https://rfrr.minsalud.gov.co

# ── Callback Security ──
CALLBACK_ALLOWED_HOSTS=laravel-app.com,localhost
CALLBACK_HMAC_SECRET=cambiar-en-produccion

# ── Playwright ──
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT=60000

# ── Credenciales EPS (usar vault en producción) ──
# EPS_COMPENSAR_CREDENTIAL_REF=vault:eps/compensar
# EPS_SANITAS_CREDENTIAL_REF=vault:eps/sanitas
# EPS_NUEVAEPS_CREDENTIAL_REF=vault:eps/nuevaeps

# ── Concurrencia ──
CELERY_WORKER_CONCURRENCY=4
MAX_BROWSER_CONTEXTS=4

# ── Storage temporal ──
TEMP_DIR=/tmp/pdf-a-radicado
EVIDENCE_DIR=/tmp/pdf-a-radicado/evidencias
